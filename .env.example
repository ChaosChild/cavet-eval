# Corpus definition. Copy to .env and fill in. .env is gitignored on purpose:
# the harness and methodology are public, the subject list is not.
#
# CORPUS_<n>_REPO   owner/name on GitHub
# CORPUS_<n>_REF    commit SHA to pin. Never a branch: results must be reproducible.
# CORPUS_<n>_LANG   primary language, for grouping in the report
# CORPUS_<n>_RATIO  measured agent-attribution ratio at the pinned ref (see scripts/measure-corpus.py)

CORPUS_1_REPO=
CORPUS_1_REF=
CORPUS_1_LANG=
CORPUS_1_RATIO=

CORPUS_2_REPO=
CORPUS_2_REF=
CORPUS_2_LANG=
CORPUS_2_RATIO=

CORPUS_3_REPO=
CORPUS_3_REF=
CORPUS_3_LANG=
CORPUS_3_RATIO=

CORPUS_4_REPO=
CORPUS_4_REF=
CORPUS_4_LANG=
CORPUS_4_RATIO=

CORPUS_5_REPO=
CORPUS_5_REF=
CORPUS_5_LANG=
CORPUS_5_RATIO=

# Harness launchers. ZCode ships its CLI inside the desktop app as a Node bundle.
HARNESS_CLAUDE_BIN=claude
HARNESS_OPENCODE_BIN=opencode
HARNESS_ZCODE_BIN=node C:/Users/<you>/AppData/Local/Programs/ZCode/resources/glm/zcode.cjs

# ZCode: --settings and --max-turns are documented but NOT implemented in 0.16.5.
# Model config is global (~/.zcode/cli/config.json, top-level "model" key), so ZCode
# cells must run serially with the config rewritten between them. See README 5.5.
ZCODE_CONFIG_PATH=C:/Users/<you>/.zcode/cli/config.json
ZCODE_PROVIDER=zai
ZCODE_BASE_URL=
ZCODE_API_KEY=

# Hard spend cap in USD, computed from the rate table in README 5.3. The runner
# halts the matrix when the running total crosses this.
BUDGET_USD_CAP=25
RUN_TIMEOUT_SECONDS=900

# Pairing rule: each model runs in its own vendor's harness (README 5.0).
# Muse Spark is the exception; Meta ships no harness, so OpenCode substitutes.
MODELS_CLAUDE=claude-opus-5,claude-sonnet-5
MODELS_ZCODE=GLM-5.3,GLM-5.3-Flash
MODELS_QWENCODE=qwen3.8-max,qwen3.8-flash
MODELS_ANTIGRAVITY=gemini-3.8-flash
MODELS_OPENCODE=opencode/muse-spark-1.3-contributor-free

# Not yet installed. Both document headless modes; verify before matrix design.
HARNESS_QWENCODE_BIN=qwen
HARNESS_ANTIGRAVITY_BIN=agy

# Which Alibaba endpoint the keys point at. Beijing is 60-70% cheaper than
# Singapore, so the cost column is meaningless without this recorded.
ALIBABA_ENDPOINT=singapore

# Repetitions per cell. Agent runs are non-deterministic; 1 is not a measurement.
REPS=3

# Reasoning effort for harnesses that expose a control (README 5.9):
# claude/agy take it as --effort; qwen reads generationConfig.reasoning
# from its settings.json; zcode and opencode have no headless control.
REASONING_EFFORT=medium

# Pinned cavet binary (absolute path, plan §2.1). bench.py invokes cavet ONLY
# through this, and on cavet-arm/arm-C cells puts its directory first on the
# harness subprocess PATH so the agent's own `cavet` resolves to the same
# build. Binary, --version and the engine digest are recorded per cell at
# start and end. Fallback when unset: bare `cavet` from PATH (not pinned).
CAVET_BIN=

# Phase-1 rotation order (plan §4): comma-separated pair shorthands, matched
# against the MODELS_* lists above. muse-spark-zen = the opencode-hosted free
# route. An explicit list is the EXACT set: pairs left out are paused (no
# cells dispatched) until re-added - that is how you sit a pair out. Only
# when ROTATION is unset entirely does the default include every configured
# pair, so a new pair is never silently dropped.
ROTATION=qwen3.7-plus,GLM-5.3,qwen3.8-max,claude-sonnet-5,gemini-3.8-flash,GLM-5.3-Flash,muse-spark-zen,claude-opus-5

# Timeout for a headless `cavet scan --full` in the arm C comparator (plan §3.3).
SCAN_TIMEOUT_SECONDS=1200
